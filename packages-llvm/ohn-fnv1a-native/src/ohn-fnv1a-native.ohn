// ohn-fnv1a-native.ohn
// Ohnrscript LLVM IR Standard Library — FNV-1a Hash
//
// Status: Architecture-proved. All constructs are in the supported generator subset.
// No unsupported constructs — grep '; UNSUPPORTED' on emitted .ll returns zero results.
//
// Pipeline: .ohn → Ohnrscript LLVM generator → .ll → clang -O3 -march=native → ARM64 native binary
//
// NOTE ON Math.imul:
// The V8 version of FNV-1a in arena.ohn uses Math.imul(hash, 16777619) to guarantee
// 32-bit truncating multiplication without HeapNumber promotion.
// In LLVM IR, 'mul i32' is already 32-bit truncating by specification — no Math.imul needed.
// Plain '*' is used here. The arithmetic output is identical.
//
// CONSTRAINT: All arithmetic uses | 0 (SMI-safe). Parameters are i64 byte array addresses.

'use strict';

// fnv1a: FNV-1a hash of bytes in [offset, offset+length)
// source is a raw Uint8Array base pointer passed as i64 address.
// Returns a signed 32-bit hash value.
function fnv1a(source, offset, length) {
    let hash = 2166136261 | 0;  // FNV offset basis (fits in i32 with wrapping)
    const end = (offset + length) | 0;
    let i = offset | 0;
    while (i < end) {
        hash = (hash ^ (source[i] | 0)) | 0;
        hash = (hash * 16777619) | 0;          // FNV prime — LLVM mul i32 truncates correctly
        i = (i + 1) | 0;
    }
    return hash | 0;
}

// fnv1aRange: convenience wrapper — hash from index 0 to length
function fnv1aRange(source, length) {
    return fnv1a(source, 0, length) | 0;
}

// compareBytes: zero-allocation byte-by-byte comparison
// Returns 1 if equal, 0 if not.
function compareBytes(a, aOffset, b, bOffset, length) {
    let i = 0;
    while (i < length) {
        if ((a[(aOffset + i) | 0] | 0) !== (b[(bOffset + i) | 0] | 0)) {
            return 0;
        }
        i = (i + 1) | 0;
    }
    return 1;
}
