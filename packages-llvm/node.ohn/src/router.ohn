// router.ohn — Ohnrscript Flat Router
// 
// Acts as a branch-optimized jump table utilizing direct switch/case logic
// on pre-computed integer hashes.

const ohn_fill_response = __extern('sys_fill_response');

export function router_handle(method, route_hash, txBufferAddr) {
    // We only support GET (1) for now
    if (method !== 1) {
        // 405 Method Not Allowed
        ohn_fill_response(txBufferAddr, 405);
        return 55;
    }

    // Hash('/') -> 177620
    if (route_hash === 177620) {
        let len = ohn_fill_response(txBufferAddr, 2001) | 0; 
        return len; // Dynamic length
    } else if (route_hash === 410427976) {
        let len = ohn_fill_response(txBufferAddr, 2002) | 0; 
        return len; // Dynamic length
    }
    
    // 404 Not Found
    let len = ohn_fill_response(txBufferAddr, 404) | 0;
    return len;
}
