// ohn-sort-native.ohn
// Ohnrscript LLVM IR Standard Library — Integer Sorting & Search
//
// Status: Architecture-proved. All constructs are in the supported generator subset.
// No unsupported constructs — grep '; UNSUPPORTED' on emitted .ll returns zero results.
//
// Pipeline: .ohn → Ohnrscript LLVM generator → .ll → clang -O3 -march=native → ARM64 native binary
//
// NOTE: No 'break' statement is used — loops terminate via condition variables
// (innerLength shrinks for bubble sort; return is used for search results).
// This keeps all constructs within the proved generator subset.
//
// CONSTRAINT: All arithmetic uses | 0 (SMI-safe). Array parameters are i64 addresses.

'use strict';

// bubbleSort: in-place sort of n Int32 elements at arr
// No break — uses a 'swapped' flag to converge early
function bubbleSort(arr, n) {
    let outerEnd = (n - 1) | 0;
    while (outerEnd > 0) {
        let i = 0;
        let lastSwap = 0;
        while (i < outerEnd) {
            const a = arr[i] | 0;
            const b = arr[(i + 1) | 0] | 0;
            if (a > b) {
                arr[i] = b;
                arr[(i + 1) | 0] = a;
                lastSwap = i | 0;
            }
            i = (i + 1) | 0;
        }
        outerEnd = lastSwap | 0;
    }
    return n | 0;
}

// insertionSort: in-place sort of n Int32 elements at arr
// Optimal for small arrays; LLVM unrolls inner loop
function insertionSort(arr, n) {
    let i = 1;
    while (i < n) {
        const key = arr[i] | 0;
        let j = (i - 1) | 0;
        while (j >= 0) {
            if ((arr[j] | 0) <= key) {
                j = -1;  // sentinel to exit inner loop without break
            } else {
                arr[(j + 1) | 0] = arr[j] | 0;
                j = (j - 1) | 0;
            }
        }
        arr[(j + 1) | 0] = key;
        i = (i + 1) | 0;
    }
    return n | 0;
}

// linearSearch: find first index of target in arr[0..n)
// Returns index if found, -1 if not found.
// Uses return-from-loop instead of break.
function linearSearch(arr, n, target) {
    let i = 0;
    while (i < n) {
        if ((arr[i] | 0) === (target | 0)) {
            return i | 0;
        }
        i = (i + 1) | 0;
    }
    return -1;
}

// binarySearch: find index of target in sorted arr[0..n)
// Returns index if found, -1 if not found.
// Uses return-from-loop instead of break.
function binarySearch(arr, n, target) {
    let lo = 0;
    let hi = (n - 1) | 0;
    while (lo <= hi) {
        const mid = (lo + ((hi - lo) >> 1)) | 0;
        const val = arr[mid] | 0;
        if (val === (target | 0)) {
            return mid | 0;
        }
        if (val < (target | 0)) {
            lo = (mid + 1) | 0;
        } else {
            hi = (mid - 1) | 0;
        }
    }
    return -1;
}
