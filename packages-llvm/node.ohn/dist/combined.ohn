// http.ohn — Ohnrscript Raw HTTP Parser
// 
// Scans the incoming DOD buffer for the '\r\n\r\n' end-of-header sequence,
// matches the HTTP method via integer casting, and computes a rolling route hash.

let CR = 13; // '\r'
let LF = 10; // '\n'
let SP = 32; // ' ' (0x20)
let QM = 63; // '?' (0x3F)

// Integer-Cast Method Constants (Little Endian)
// "GET " -> 0x20544547 (542393671)
let METHOD_GET = 542393671;
// "POST" -> 0x54534F50 (1414745936)
let METHOD_POST = 1414745936;
// LOCAL helper functions — inlined from network_parser.ohn to avoid
// the i32/i64 __extern ABI mismatch at the LLVM IR cross-module boundary.
// Prefixed http_local_ to prevent linker duplicate symbol errors.
function http_local_readUint8(buf_offset, byteOffset) {
    let wordIndex = (buf_offset + (byteOffset >>> 2)) | 0;
    let bitShift = (byteOffset & 3) * 8;
    return (read_buf[wordIndex] >>> bitShift) & 0xFF;
}

function http_local_readUint32_LE(buffer, byteOffset) {
    let b0 = http_local_readUint8(buffer, byteOffset);
    let b1 = http_local_readUint8(buffer, (byteOffset + 1) | 0);
    let b2 = http_local_readUint8(buffer, (byteOffset + 2) | 0);
    let b3 = http_local_readUint8(buffer, (byteOffset + 3) | 0);
    return ((b3 << 24) | (b2 << 16) | (b1 << 8) | b0) >>> 0;
}

// router_handle is defined in router.ohn which is compiled into the same unit.
// Calling it directly avoids a duplicate declare in the generated LLVM IR.

function http_parse_method(buf_ptr) {
    let method_int = http_local_readUint32_LE(buf_ptr, 0) | 0;
    
    if (method_int === METHOD_GET) {
        return 1;
    }
    if (method_int === METHOD_POST) {
        return 2;
    }
    return 0; // Unknown
}

let parse_result = new Int32Array(2); // [hash, end_offset]

function http_parse_route_hash(buf_ptr, start_offset, total_bytes) {
    let i = start_offset | 0;
    let limit = total_bytes | 0;
    
    // Safety check: max URI length 2048
    if (limit > 2048) {
        limit = 2048;
    }

    let hash = 5381; // djb2 hash base
    
    while (i < limit) {
        let b = http_local_readUint8(buf_ptr, i) | 0;
        
        if (b === SP) {
            parse_result[0] = hash;
            parse_result[1] = i; 
            return 1; // Success
        }
        
        if (b === QM) {
            parse_result[0] = hash;
            // Scan forward to the space
            let j = (i + 1) | 0;
            while (j < limit) {
                let check_b = http_local_readUint8(buf_ptr, j) | 0;
                if (check_b === SP) {
                    parse_result[1] = j;
                    return 1; // Success
                }
                j = (j + 1) | 0;
            }
            return -1; // Missing SP
        }
        
        hash = ((hash * 33) + b) | 0;
        i = (i + 1) | 0;
    }
    
    return -1; // Overflow or malformed
}

// Returns the index of the byte immediately following '\r\n\r\n',
// or -1 if the sequence is not found yet (incomplete headers).
function http_find_headers_end(buf_ptr, total_bytes) {
    if ((total_bytes | 0) < 4) {
        return -1;
    }

    let i = 0;
    let limit = (total_bytes - 3) | 0;

    while (i < limit) {
        let b0 = http_local_readUint8(buf_ptr, i) | 0;
        
        if (b0 === CR) {
            let b1 = http_local_readUint8(buf_ptr, (i + 1) | 0) | 0;
            if (b1 === LF) {
                let b2 = http_local_readUint8(buf_ptr, (i + 2) | 0) | 0;
                if (b2 === CR) {
                    let b3 = http_local_readUint8(buf_ptr, (i + 3) | 0) | 0;
                    if (b3 === LF) {
                        return (i + 4) | 0; // Header ends, body begins
                    }
                }
            }
        }
        i = (i + 1) | 0;
    }

    return -1;
}

export function http_process_payload(rxBufferAddr, payloadLen, txBufferAddr) {
    let method = http_parse_method(rxBufferAddr);
    if (method === 0) return 0;
    
    let offset = 4;
    if (method === 2) {
        offset = 5;
    }
    
    let result = http_parse_route_hash(rxBufferAddr, offset, payloadLen);
    if (result !== 1) return 0;
    
    let hash = parse_result[0] | 0;
    
    let responseLen = router_handle(method, hash, txBufferAddr) | 0;
    return responseLen;
}
// router.ohn — Ohnrscript Flat Router
// 
// Acts as a branch-optimized jump table utilizing direct switch/case logic
// on pre-computed integer hashes.

const ohn_fill_response = __extern('sys_fill_response');

export function router_handle(method, route_hash, txBufferAddr) {
    // We only support GET (1) for now
    if (method !== 1) {
        // 405 Method Not Allowed
        ohn_fill_response(txBufferAddr, 405);
        return 55;
    }

    // Hash('/') -> 177620
    if (route_hash === 177620) {
        ohn_fill_response(txBufferAddr, 2001); 
        return 75; // Total length of headers + body
    } else if (route_hash === 410427976) {
        ohn_fill_response(txBufferAddr, 2002); 
        return 86; // Total length of headers + body
    }
    
    // 404 Not Found
    ohn_fill_response(txBufferAddr, 404);
    return 54;
}
// mpsc.ohn — Lock-Free Multi-Producer Single-Consumer Queue
// Written in Ohnrscript.
//
// Prevents the "eventfd Wakeup Storm" deadlocks.
// Background threads (producers) push completion events to this queue atomically.
// They only write to the eventfd pipe if they transition the queue from Empty to Not-Empty.
// The main event loop (consumer) drains the queue instantly in user-space.
//
// Architecture: intra-process only.
// Each forked worker has its own private MPSC queue. Background threads within
// that worker push into it; the worker's main event loop (kqueue/epoll) pops from it.
// Cross-worker coordination is handled at the kernel level by SO_REUSEPORT.

let MPSC_CAPACITY = 16384; // Power of 2 for fast modulo
let MPSC_MASK = 16383;     // Capacity - 1

// Ring buffer for IPC events (e.g., storing the slot ID of completed work).
// Pre-filled with sentinel -1 to guard the producer-claims-before-write race:
// a producer atomically claims a head index BEFORE writing slot data into it.
// The consumer must spin until the sentinel is replaced with real data.
let mpsc_queue = new Int32Array(MPSC_CAPACITY);

// head and tail as single-element Int32Arrays so their heap byte offsets
// can be resolved to real pointers in bindings.c for hardware atomic ops.
let mpsc_head = new Int32Array(1); // Written by producers (CAS)
let mpsc_tail = new Int32Array(1); // Written by consumer (main loop only — no atomics needed)

// Atomic primitives — implemented in bindings.c via __atomic_* GCC/Clang builtins.
// sys_atomic_cmpxchg(offset_bytes, expected, replacement) → 1 on success, 0 on failure
const ohn_atomic_add    = __extern('sys_atomic_add');
const ohn_atomic_cmpxchg = __extern('sys_atomic_cmpxchg');

// Initialize the ring buffer slots to -1 (sentinel: slot not yet written by producer).
// Called once at startup before any threads are spawned.
function mpsc_init() {
    let i = 0;
    while (i < MPSC_CAPACITY) {
        mpsc_queue[i] = -1;
        i = (i + 1) | 0;
    }
    mpsc_head[0] = 0;
    mpsc_tail[0] = 0;
}

// Producer: Push an event onto the queue from a background thread.
// Uses a CAS loop to atomically claim the next head index.
// After claiming, writes the slot data and replaces the sentinel.
//
// Returns 1 if the queue was previously empty (caller should signal eventfd).
// Returns 0 if the queue was already non-empty (eventfd already signalled).
// Returns -1 if the queue is full.
function mpsc_push(slot) {
    // CAS loop: atomically claim the next head index.
    // Multiple threads may race here; only one wins each iteration.
    let current_head = 0;
    let next_head = 0;
    let claimed = 0;

    while (claimed === 0) {
        current_head = mpsc_head[0] | 0;
        next_head = (current_head + 1) & MPSC_MASK;

        // Check for full queue before attempting CAS.
        if (next_head === (mpsc_tail[0] | 0)) {
            return -1; // Queue full
        }

        // Attempt to advance head from current_head to next_head.
        // If another thread claimed current_head first, this returns 0 and we retry.
        // mpsc_head is an Int32Array(1); its byte offset in ohn_heap_base is mpsc_head * 4.
        // The runtime allocator returns a uint32 byte offset; we pass it directly.
        let head_offset = mpsc_head | 0; // Int32Array ref is its heap byte offset in LLVM
        claimed = ohn_atomic_cmpxchg(head_offset, current_head, next_head) | 0;
    }

    // We own current_head. Write the slot data, replacing the sentinel.
    // The consumer will spin on this slot until it sees a value !== -1.
    mpsc_queue[current_head] = slot;

    // Was the queue empty before our push?
    if (current_head === (mpsc_tail[0] | 0)) {
        return 1; // Signal eventfd — queue just became non-empty
    }
    return 0; // Already non-empty, eventfd already awake
}

// Consumer: Drain a single event from the queue in the main event loop.
// Only one consumer (the main loop) ever calls this — no atomics needed on tail.
//
// Returns the slot ID, or -1 if empty or slot not yet written by producer.
function mpsc_pop() {
    let current_tail = mpsc_tail[0] | 0;

    if (current_tail === (mpsc_head[0] | 0)) {
        return -1; // Queue is empty
    }

    // Spin until the producer has written real data (sentinel guard).
    let slot = mpsc_queue[current_tail] | 0;
    if (slot === -1) {
        // Producer claimed this slot but hasn't written yet. Return -1
        // and let the event loop retry on the next poll cycle.
        return -1;
    }

    // Reset slot to sentinel before advancing tail (prevents stale reads).
    mpsc_queue[current_tail] = -1;
    mpsc_tail[0] = (current_tail + 1) & MPSC_MASK;

    return slot;
}
// outbound.ohn — High-Water Mark Application Backpressure
// Written in Ohnrscript.
//
// Mitigates Tarpit Attacks (clients downloading at 1 byte/sec).
// When the kernel TCP buffer fills (EAGAIN), userland data must be queued.
// If the queued data per-socket exceeds OUTBOUND_HWM, res.write() returns false.
// This pauses Ohnrscript userland from generating more data until the queue drains.

// 2MB limit per socket
let OUTBOUND_HWM = 2097152;
let MAX_CONN     = 4096;

// Flat array holding the current total bytes queued for each socket slot.
// (In a real implementation, this tracks offsets into a circular linked list
// of buffer chunks, but for this POC we track the absolute byte count to 
// trigger the backpressure logic).
let queued_bytes = new Int32Array(MAX_CONN);

// Flat array holding the backpressure state (1 = paused, 0 = active).
let paused_state = new Int32Array(MAX_CONN);

// Add data to the outbound queue. Returns 1 if successful, 
// 0 if backpressure High-Water Mark is hit (meaning userland MUST yield).
function outbound_enqueue(slot, byte_len) {
    let current = queued_bytes[slot] | 0;
    let next_total = (current + byte_len) | 0;

    if (next_total > OUTBOUND_HWM) {
        paused_state[slot] = 1;
        return 0; // Backpressure engaged: yield false to userland.
    }

    queued_bytes[slot] = next_total;
    return 1;
}

// Called when kqueue/epoll EVFILT_WRITE fires and kernel accepts data.
function outbound_dequeue(slot, bytes_sent) {
    let current = queued_bytes[slot] | 0;
    let remaining = (current - bytes_sent) | 0;
    if (remaining < 0) remaining = 0;
    
    queued_bytes[slot] = remaining;

    // If we were paused and the queue has drained significantly (e.g. half HWM),
    // we unpause and fire the internal 'drain' event to userland.
    if ((paused_state[slot] | 0) === 1) {
        let low_water_mark = (OUTBOUND_HWM / 2) | 0;
        if (remaining <= low_water_mark) {
            paused_state[slot] = 0;
            // TODO: Dispatch 'drain' event to userland callback queue.
            return 1; // Unpaused
        }
    }
    return 0;
}

function outbound_clear(slot) {
    queued_bytes[slot] = 0;
    paused_state[slot] = 0;
}
// timeout.ohn — O(1) Connection Eviction (Min-Heap Priority Queue)
// Written in Ohnrscript.
//
// To avoid iterating over 10,000 connections every tick (O(N) bottleneck),
// we maintain a Min-Heap. The root node (index 0) always contains the
// slot ID of the socket that has been idle the longest.
// Checking for timeouts becomes an O(1) operation.

let HEAP_MAX = 4096;

// Flat array holding socket slot IDs.
let heap_slots = new Int32Array(HEAP_MAX);

// Flat array holding the expiration timestamp for the slot in the heap.
let heap_expires = new Int32Array(HEAP_MAX);

// Maps a socket slot ID back to its index in the heap for O(1) updates.
let slot_to_heap_idx = new Int32Array(HEAP_MAX);

let heap_size = 0;

function heap_swap(i, j) {
    let slot_i = heap_slots[i] | 0;
    let slot_j = heap_slots[j] | 0;
    
    let exp_i = heap_expires[i] | 0;
    let exp_j = heap_expires[j] | 0;

    heap_slots[i] = slot_j;
    heap_slots[j] = slot_i;

    heap_expires[i] = exp_j;
    heap_expires[j] = exp_i;

    slot_to_heap_idx[slot_i] = j;
    slot_to_heap_idx[slot_j] = i;
}

function heap_sift_up(start_idx) {
    let idx = start_idx | 0;
    while (idx > 0) {
        let parent = ((idx - 1) / 2) | 0;
        let exp_idx = heap_expires[idx] | 0;
        let exp_parent = heap_expires[parent] | 0;
        
        if (exp_idx < exp_parent) {
            heap_swap(idx, parent);
            idx = parent;
        } else {
            return 0;
        }
    }
}

function heap_sift_down(start_idx) {
    let size = heap_size | 0;
    let idx = start_idx | 0;
    while (1) {
        let left = (2 * idx + 1) | 0;
        let right = (2 * idx + 2) | 0;
        let smallest = idx | 0;

        if (left < size) {
            let exp_left = heap_expires[left] | 0;
            let exp_smallest = heap_expires[smallest] | 0;
            if (exp_left < exp_smallest) {
                smallest = left;
            }
        }

        if (right < size) {
            let exp_right = heap_expires[right] | 0;
            let exp_smallest = heap_expires[smallest] | 0;
            if (exp_right < exp_smallest) {
                smallest = right;
            }
        }

        if (smallest !== idx) {
            heap_swap(idx, smallest);
            idx = smallest;
        } else {
            return 0;
        }
    }
}

// ── Public API ──

// Add a new socket slot to the timeout tracking heap.
function timeout_add(slot, expire_ts) {
    let size = heap_size | 0;
    if (size >= HEAP_MAX) return -1;

    heap_slots[size] = slot;
    heap_expires[size] = expire_ts;
    slot_to_heap_idx[slot] = size;
    
    heap_size = (size + 1) | 0;
    heap_sift_up(size);
    return 0;
}

// Update the expiration time for an active socket.
function timeout_touch(slot, new_expire_ts) {
    let idx = slot_to_heap_idx[slot] | 0;
    if (idx < 0 || idx >= (heap_size | 0)) return -1;

    let old_ts = heap_expires[idx] | 0;
    heap_expires[idx] = new_expire_ts;

    if (new_expire_ts < old_ts) {
        heap_sift_up(idx);
    } else {
        heap_sift_down(idx);
    }
    return 0;
}

// Remove a socket from the heap (e.g. when closed gracefully).
function timeout_remove(slot) {
    let size = heap_size | 0;
    let idx = slot_to_heap_idx[slot] | 0;
    if (idx < 0 || idx >= size) return -1;

    let last_idx = (size - 1) | 0;
    heap_swap(idx, last_idx);
    heap_size = last_idx;

    slot_to_heap_idx[slot] = -1;

    if (idx < last_idx) {
        heap_sift_up(idx);
        heap_sift_down(idx);
    }
    return 0;
}

// O(1) Check: Returns the slot ID if it has expired relative to current_ts.
// Returns -1 if nothing has expired.
function timeout_poll(current_ts) {
    if ((heap_size | 0) === 0) return -1;

    let min_ts = heap_expires[0] | 0;
    if (min_ts <= current_ts) {
        let slot = heap_slots[0] | 0;
        timeout_remove(slot);
        return slot;
    }
    
    return -1;
}
// loop.ohn — node.ohn Core Event Loop
// Written in Ohnrscript. Compiles to LLVM IR via self-hosted compiler.
//
// Architecture:
//   - Uses kqueue (macOS) or epoll (Linux) via bindings.c shims.
//   - Maintains per-socket state in flat DOD arrays (no heap objects).
//   - Implements O(1) connection timeout via Min-Heap (see timeout.ohn).
//   - Implements SIGTERM graceful draining.
//   - Implements incoming backpressure (EPOLLIN deregistration).

// ── Constants ──
// These are platform event filter/flag values passed as flat i64 integers
// through bindings.c, so Ohnrscript never touches raw C structs.
let EVFILT_READ  = -1;   // kqueue read filter
let EVFILT_WRITE = -2;   // kqueue write filter
let EV_ADD       = 1;
let EV_DELETE    = 2;
let EV_DISABLE   = 8;
let EV_ENABLE    = 4;

let EPOLLIN      = 1;    // epoll readable
let EPOLLOUT     = 4;    // epoll writable
let EPOLLET      = -2147483647 - 1; // edge-triggered (0x80000000 as i32)

// ── DOD Socket State Arrays ──
// Each active connection is tracked by its file descriptor as the index key.
// All state is flat integers — no heap allocation ever.
let MAX_CONN         = 4096;
let STATE_IDLE          = 0;
let STATE_READING       = 1;
let STATE_WRITING       = 2;
let STATE_DRAINING      = 3;   // SIGTERM draining phase
let STATE_TLS_HANDSHAKE = 4;   // mbedTLS handshake in progress

// Per-socket flat arrays (indexed by slot, not fd).
// fd_table[slot] = fd, state_table[slot] = STATE_*, etc.
let fd_table        = new Int32Array(MAX_CONN);
let state_table     = new Int32Array(MAX_CONN);
let bytes_read      = new Int32Array(MAX_CONN);
let bytes_written   = new Int32Array(MAX_CONN);
let last_active_ts  = new Int32Array(MAX_CONN);

// Parser State Tracking for Fragmented TCP
let parse_state      = new Int32Array(MAX_CONN); // 0=Method, 1=Route, 2=Headers
let parse_method     = new Int32Array(MAX_CONN);
let current_hash     = new Int32Array(MAX_CONN);
let bytes_processed  = new Int32Array(MAX_CONN);

// Active connection count — used for graceful draining.
let active_count    = 0;

// Drain mode — set to 1 when SIGTERM received.
let draining_mode   = 0;

// Read/write ring buffer (shared across all connections via slot indexing).
// Each slot is 8KB (sufficient for HTTP headers + small bodies).
let BUF_SLOT_SIZE   = 8192;
let read_buf        = new Int32Array(MAX_CONN * BUF_SLOT_SIZE / 4);

// Outbound High-Water Mark: 2MB per socket before backpressure engages.
let OUTBOUND_HWM    = 2097152;

// Event results buffer: kqueue/epoll writes [fd, filter/events, ...] pairs.
let MAX_EVENTS      = 256;
let event_results   = new Int32Array(MAX_EVENTS * 2);

// ── Externs from bindings.c ──
const ohn_kqueue_create = __extern('sys_kqueue_create');
const ohn_kqueue_register = __extern('sys_kqueue_register');
const ohn_kqueue_wait = __extern('sys_kqueue_wait');
const ohn_socket_accept = __extern('sys_socket_accept');
const ohn_socket_nonblock = __extern('sys_socket_nonblock');
const ohn_socket_read = __extern('sys_socket_read');
const ohn_socket_write = __extern('sys_socket_write');
const ohn_socket_close = __extern('sys_socket_close');
const ohn_fill_http_response = __extern('sys_fill_http_response');

const ohn_time_sec = __extern('sys_time_sec');

// ── MPSC Integration ──
// mpsc_push is defined in mpsc.ohn, but we need to declare it if they are compiled together.
// In Ohnrscript, functions from other files compiled together are globally visible,
// so we can just call mpsc_push(slot).


// ── Globals ──
let current_sec = 0;

// ── TLS Externs ──
const ohn_tls_connect = __extern('sys_tls_connect');
const ohn_tls_handshake = __extern('sys_tls_handshake');
const ohn_tls_read = __extern('sys_tls_read');
const ohn_tls_write = __extern('sys_tls_write');
const ohn_tls_close = __extern('sys_tls_close');

// ── Slot Management ──
// Find the first idle slot. Returns -1 if full (server at capacity).
function findFreeSlot() {
    let i = 0;
    while (i < MAX_CONN) {
        if ((state_table[i] | 0) === STATE_IDLE) {
            return i;
        }
        i = (i + 1) | 0;
    }
    return -1;
}

// Find the slot for a given fd. Returns -1 if not found.
function findSlotByFd(fd) {
    let i = 0;
    while (i < MAX_CONN) {
        if ((fd_table[i] | 0) === fd && (state_table[i] | 0) !== STATE_IDLE) {
            return i;
        }
        i = (i + 1) | 0;
    }
    return -1;
}

// Release a slot and close the socket.
function closeSlot(kq, slot) {
    let fd = fd_table[slot] | 0;
    ohn_tls_close(slot); // Free TLS context
    ohn_socket_close(fd);
    timeout_remove(slot);
    fd_table[slot]    = 0;
    state_table[slot] = STATE_IDLE;
    bytes_read[slot]  = 0;
    bytes_written[slot] = 0;
    parse_state[slot] = 0;
    parse_method[slot] = 0;
    current_hash[slot] = 0;
    bytes_processed[slot] = 0;
    active_count = (active_count - 1) | 0;
}

// ── HTTP Response Writer (Removed in favor of router.ohn) ──
// Function intentionally omitted.

// ── Accept new connections ──
function acceptConnections(kq, listen_fd) {
    while (1) {
        let client_fd = ohn_socket_accept(listen_fd) | 0;
        if (client_fd < 0) {
            // EAGAIN = no more pending connections on this tick.
            return 0;
        }

        // If server is in draining mode, reject new connections.
        if ((draining_mode | 0) === 1) {
            ohn_socket_close(client_fd);
            return 0;
        }

        ohn_socket_nonblock(client_fd);

        let slot = findFreeSlot() | 0;
        if (slot < 0) {
            // At capacity — gracefully reject.
            ohn_socket_close(client_fd);
            continue;
        }

        fd_table[slot]    = client_fd;
        state_table[slot] = STATE_TLS_HANDSHAKE;
        bytes_read[slot]  = 0;
        bytes_written[slot] = 0;
        parse_state[slot] = 0;
        parse_method[slot] = 0;
        current_hash[slot] = 0;
        bytes_processed[slot] = 0;
        active_count = (active_count + 1) | 0;

        // Initialize TLS connection context for this slot
        ohn_tls_connect(slot, client_fd, 0, 1);
        
        timeout_add(slot, (current_sec + 5) | 0); // 5 second Slowloris timeout
        
        // Register for read-readiness to kick off handshake
        ohn_kqueue_register(kq, client_fd, EVFILT_READ, EV_ADD);
    }
}

// ── TLS Handshake handler ──
function handleHandshake(kq, slot) {
    let ret = ohn_tls_handshake(slot) | 0;
    let fd = fd_table[slot] | 0;
    
    if (ret === -1) {
        // WANT_READ
        ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_DELETE);
        ohn_kqueue_register(kq, fd, EVFILT_READ, EV_ADD);
    } else if (ret === -2) {
        // WANT_WRITE
        ohn_kqueue_register(kq, fd, EVFILT_READ, EV_DELETE);
        ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_ADD);
    } else if (ret === 0) {
        // Handshake Complete
        state_table[slot] = STATE_READING;
        ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_DELETE);
        ohn_kqueue_register(kq, fd, EVFILT_READ, EV_ADD);
        
        // Push completion event to MPSC queue so the Promise can resolve
        mpsc_push(slot);
        
        // timeout_touch(slot, (current_sec + 30) | 0); // 30 second keep-alive
    } else {
        // Fatal error
        closeSlot(kq, slot);
    }
}

// ── Read handler ──
function handleRead(kq, slot) {
    if ((state_table[slot] | 0) === STATE_TLS_HANDSHAKE) {
        handleHandshake(kq, slot);
        return 0;
    }

    let fd        = fd_table[slot] | 0;
    let buf_offset = (slot * BUF_SLOT_SIZE / 4) | 0;
    let n = ohn_tls_read(slot, buf_offset, BUF_SLOT_SIZE) | 0;

    if (n === -1 || n === -2) {
        // WANT_READ or WANT_WRITE (renegotiation)
        return 0;
    }

    if (n <= 0) {
        // Client disconnected or error — close slot.
        closeSlot(kq, slot);
        return 0;
    }

    timeout_touch(slot, (current_sec + 30) | 0); // Extend keep-alive on active read

    bytes_read[slot] = (bytes_read[slot] + n) | 0;

    let total_read = bytes_read[slot] | 0;

    // 1. Parse Method if we haven't yet and we have at least 5 bytes (e.g. "GET /")
    if ((parse_state[slot] | 0) === 0 && total_read >= 5) {
        let method = http_parse_method(buf_offset) | 0;
        parse_method[slot] = method;
        
        // Find where the path starts. 'GET ' is 4 bytes.
        let offset = 4;
        if (method === 2) { // POST
            offset = 5;
        }
        bytes_processed[slot] = offset;
        parse_state[slot] = 1;
    }

    // 2. Parse Route Hash if we have a method and aren't done yet
    if ((parse_state[slot] | 0) === 1) {
        let current_offset = bytes_processed[slot] | 0;
        
        let result = http_parse_route_hash(buf_offset, current_offset, total_read) | 0;
        if (result === 1) {
            // Found space or '?', parsing complete
            current_hash[slot] = parse_result[0] | 0;
            bytes_processed[slot] = parse_result[1] | 0; // The end offset
            parse_state[slot] = 2; // Moving to wait for header end
        } else if (result === -1 && total_read > 2048) {
            // Buffer overread safeguard
            closeSlot(kq, slot);
            return 0;
        }
    }

    // 3. Wait for \r\n\r\n boundary
    if ((parse_state[slot] | 0) === 2) {
        let header_end = http_find_headers_end(buf_offset, total_read) | 0;
        if (header_end > 0) {
            // Deregister EPOLLIN / EVFILT_READ to prevent re-reads (backpressure).
            ohn_kqueue_register(kq, fd, EVFILT_READ, EV_DELETE);

            // Execute Router Pipeline directly from slot state
            let method = parse_method[slot] | 0;
            let hash = current_hash[slot] | 0;
            
            let resp_len = router_handle(method, hash, buf_offset) | 0;
            bytes_written[slot] = resp_len;
            state_table[slot] = STATE_WRITING;

            // Register EPOLLOUT / EVFILT_WRITE to flush the response.
            ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_ADD);
        }
    }
}

// ── Write handler ──
function handleWrite(kq, slot) {
    if ((state_table[slot] | 0) === STATE_TLS_HANDSHAKE) {
        handleHandshake(kq, slot);
        return 0;
    }

    let fd         = fd_table[slot] | 0;
    let buf_offset = (slot * BUF_SLOT_SIZE / 4) | 0;
    let to_write   = bytes_written[slot] | 0;

    let n = ohn_tls_write(slot, buf_offset, to_write) | 0;

    if (n === -1 || n === -2) {
        // WANT_READ or WANT_WRITE (renegotiation)
        return 0;
    }

    if (n < 0) {
        // EAGAIN — kernel send buffer full. State machine stays in WRITING.
        // kqueue/epoll will re-notify when writable again.
        return 0;
    }

    timeout_touch(slot, (current_sec + 30) | 0); // Extend keep-alive on active write

    // Track partial writes (EAGAIN state machine).
    bytes_written[slot] = (bytes_written[slot] - n) | 0;

    if ((bytes_written[slot] | 0) <= 0) {
        // Response fully flushed — close connection (HTTP/1.0 style for now).
        ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_DELETE);
        closeSlot(kq, slot);
    }
}

// ── Main Event Loop ──
function ohn_event_loop_run(listen_fd) {
    let kq = ohn_kqueue_create() | 0;

    // Register the listening socket for read events (incoming connections).
    ohn_kqueue_register(kq, listen_fd, EVFILT_READ, EV_ADD);

    let event_buf_ptr = 0; // Pointer to event_results array base.
    // In Ohnrscript LLVM IR, typed array base pointers are i64 values.
    // The self-hosted compiler emits inttoptr for array access.

    let TIMEOUT_MS = 1000; // 1 second tick for timeout wheel processing.

    while (1) {
        let n = ohn_kqueue_wait(kq, event_buf_ptr, MAX_EVENTS, TIMEOUT_MS) | 0;

        // Query monotonic system clock to avoid interval drift
        current_sec = ohn_time_sec() | 0;
        
        // Process timeouts (outside event loop so it runs even if n == 0)
        while (1) {
            let expired_slot = timeout_poll(current_sec) | 0;
            if (expired_slot < 0) {
                break;
            }
            // Brutal eviction
            closeSlot(kq, expired_slot);
        }

        // Process each ready event.
        let i = 0;
        while (i < n) {
            let ev_fd     = (event_results[i * 2]     | 0);
            let ev_filter = (event_results[i * 2 + 1] | 0);

            if (ev_fd === listen_fd) {
                // New connection(s) ready to accept.
                acceptConnections(kq, listen_fd);
            } else {
                let slot = findSlotByFd(ev_fd) | 0;
                if (slot >= 0) {
                    if (ev_filter === EVFILT_READ) {
                        handleRead(kq, slot);
                    }
                    if (ev_filter === EVFILT_WRITE) {
                        handleWrite(kq, slot);
                    }
                }
            }

            i = (i + 1) | 0;
        }

        // Draining phase: if SIGTERM was received and all connections closed, exit.
        if ((draining_mode | 0) === 1 && (active_count | 0) === 0) {
            ohn_socket_close(listen_fd);
            return 0;
        }
    }
}
// server.ohn — node.ohn Top-Level Entry Point
// Written in Ohnrscript. Self-hosted compile: ohnrscript server.ohn → server.ll
//
// Architecture:
//   1. Suppress SIGPIPE globally.
//   2. Query CPU core count.
//   3. Fork N-1 worker processes (current process becomes worker 0).
//   4. Each worker enters the kqueue/epoll event loop independently.
//   5. OS kernel load-balances connections across all workers via SO_REUSEPORT.

// ── Externs from bindings.c (all params are i64 to match Ohnrscript ABI) ──
const ohn_suppress_sigpipe = __extern('sys_suppress_sigpipe');
const ohn_cpu_count = __extern('sys_cpu_count');
const ohn_socket_tcp = __extern('sys_socket_tcp');
const ohn_socket_set_reuseport = __extern('sys_socket_set_reuseport');
const ohn_socket_nonblock = __extern('sys_socket_nonblock');
const ohn_socket_bind = __extern('sys_socket_bind');
const ohn_socket_listen = __extern('sys_socket_listen');
const ohn_socket_close = __extern('sys_socket_close');
const ohn_tls_init = __extern('sys_tls_init');

// fork() is a direct libc call — returns 0 in child, PID in parent, -1 on error
const sys_fork = __extern('fork');

// Platform event loop entry points (implemented in loop.ohn)

function createListenSocket(port) {
    let fd = ohn_socket_tcp() | 0;
    if (fd < 0) {
        return -1;
    }

    let r = ohn_socket_set_reuseport(fd) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    r = ohn_socket_nonblock(fd) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    r = ohn_socket_bind(fd, port) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    // Backlog of 4096 — allows kernel to queue incoming connections
    // before accept() is called. NGINX uses 511, Actix uses 1024.
    r = ohn_socket_listen(fd, 4096) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    return fd;
}

function worker_main() {
    // 2. Create the listening socket AFTER the fork.
    // Using SO_REUSEPORT here allows multiple independent FDs to bind to 8443.
    // The OS will load-balance connections, completely eliminating the Thundering Herd.
    let PORT = 8443;
    let listen_fd = createListenSocket(PORT) | 0;
    if (listen_fd < 0) {
        return 1;
    }

    // 3. Drop into event loop
    ohn_event_loop_run(listen_fd);
    return 0;
}

function main() {
    // Force evaluation of top-level statements for this module.
    // Without this, the initialization block (which sets up globals like EVFILT_READ) is never executed.
    require('server');

    // 1. Globally suppress SIGPIPE before any socket work.
    ohn_suppress_sigpipe();

    // 2. Fork N-1 additional worker processes first!
    let cores = ohn_cpu_count() | 0;
    let i = 1;
    while (i < cores) {
        let pid = sys_fork() | 0;
        if (pid === 0) {
            // Child: drop into worker_main immediately.
            worker_main();
            return 0;
        }
        // Parent: continue forking.
        i = (i + 1) | 0;
    }

    // 3. Parent process also becomes a worker.
    worker_main();

    return 0;
}
