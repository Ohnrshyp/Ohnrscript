// http.ohn — Ohnrscript Raw HTTP Parser
// 
// Scans the incoming DOD buffer for the '\r\n\r\n' end-of-header sequence,
// matches the HTTP method via integer casting, and computes a rolling route hash.

let CR = 13; // '\r'
let LF = 10; // '\n'
let SP = 32; // ' ' (0x20)
let QM = 63; // '?' (0x3F)

// Integer-Cast Method Constants (Little Endian)
// "GET " -> 0x20544547 (542393671)
let METHOD_GET = 542393671;
// "POST" -> 0x54534F50 (1414745936)
let METHOD_POST = 1414745936;
// LOCAL helper functions — inlined from network_parser.ohn to avoid
// the i32/i64 __extern ABI mismatch at the LLVM IR cross-module boundary.
// Prefixed http_local_ to prevent linker duplicate symbol errors.
function http_local_readUint8(buffer, byteOffset) {
    let wordIndex = byteOffset >>> 2;
    let bitShift = (byteOffset & 3) * 8;
    return (buffer[wordIndex] >>> bitShift) & 0xFF;
}

function http_local_readUint32_LE(buffer, byteOffset) {
    let b0 = http_local_readUint8(buffer, byteOffset);
    let b1 = http_local_readUint8(buffer, (byteOffset + 1) | 0);
    let b2 = http_local_readUint8(buffer, (byteOffset + 2) | 0);
    let b3 = http_local_readUint8(buffer, (byteOffset + 3) | 0);
    return ((b3 << 24) | (b2 << 16) | (b1 << 8) | b0) >>> 0;
}

const http_router_handle = __extern('router_handle');

function http_parse_method(buf_ptr) {
    let method_int = http_local_readUint32_LE(buf_ptr, 0) | 0;
    
    if (method_int === METHOD_GET) {
        return 1;
    }
    if (method_int === METHOD_POST) {
        return 2;
    }
    return 0; // Unknown
}

let parse_result = new Int32Array(2); // [hash, end_offset]

function http_parse_route_hash(buf_ptr, start_offset, total_bytes) {
    let i = start_offset | 0;
    let limit = total_bytes | 0;
    
    // Safety check: max URI length 2048
    if (limit > 2048) {
        limit = 2048;
    }

    let hash = 5381; // djb2 hash base
    
    while (i < limit) {
        let b = http_local_readUint8(buf_ptr, i) | 0;
        
        if (b === SP) {
            parse_result[0] = hash;
            parse_result[1] = i; 
            return 1; // Success
        }
        
        if (b === QM) {
            parse_result[0] = hash;
            // Scan forward to the space
            let j = (i + 1) | 0;
            while (j < limit) {
                let check_b = http_local_readUint8(buf_ptr, j) | 0;
                if (check_b === SP) {
                    parse_result[1] = j;
                    return 1; // Success
                }
                j = (j + 1) | 0;
            }
            return -1; // Missing SP
        }
        
        hash = ((hash * 33) + b) | 0;
        i = (i + 1) | 0;
    }
    
    return -1; // Overflow or malformed
}

// Returns the index of the byte immediately following '\r\n\r\n',
// or -1 if the sequence is not found yet (incomplete headers).
function http_find_headers_end(buf_ptr, total_bytes) {
    if ((total_bytes | 0) < 4) {
        return -1;
    }

    let i = 0;
    let limit = (total_bytes - 3) | 0;

    while (i < limit) {
        let b0 = http_local_readUint8(buf_ptr, i) | 0;
        
        if (b0 === CR) {
            let b1 = http_local_readUint8(buf_ptr, (i + 1) | 0) | 0;
            if (b1 === LF) {
                let b2 = http_local_readUint8(buf_ptr, (i + 2) | 0) | 0;
                if (b2 === CR) {
                    let b3 = http_local_readUint8(buf_ptr, (i + 3) | 0) | 0;
                    if (b3 === LF) {
                        return (i + 4) | 0; // Header ends, body begins
                    }
                }
            }
        }
        i = (i + 1) | 0;
    }

    return -1;
}

export function http_process_payload(rxBufferAddr, payloadLen, txBufferAddr) {
    let method = http_parse_method(rxBufferAddr);
    if (method === 0) return 0;
    
    let offset = 4;
    if (method === 2) {
        offset = 5;
    }
    
    let result = http_parse_route_hash(rxBufferAddr, offset, payloadLen);
    if (result !== 1) return 0;
    
    let hash = parse_result[0] | 0;
    
    // In Ohnrscript, router_handle is globally linked since we compile both files
    let responseLen = http_router_handle(method, hash, txBufferAddr) | 0;
    return responseLen;
}
