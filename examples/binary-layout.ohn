// binary-layout.ohn
// Ohnrscript Example: @binaryLayout Decorator
//
// Demonstrates:
//   - The @binaryLayout decorator for zero-allocation memory-mapped structs
//   - @type() and @size() field annotations
//   - How the AOT compiler generates typed getters/setters over a raw ArrayBuffer
//
// When compiled with `npx ohnc`, the compiler transforms this class into a
// wrapper that reads/writes fields at fixed byte offsets — zero heap allocation,
// zero copying. This is how Ohnrscript handles high-throughput binary data
// (audio ML packets, network payloads, sensor telemetry) without GC pressure.
//
// Compile (V8):  npx ohnc examples/binary-layout.ohn
//
// Usage after compilation:
//   const packet = AudioMLBatch.fromBuffer(networkBuffer);
//   processEmbedding(packet.embedding);

@binaryLayout
class AudioMLBatch {
  // Packet Header Information
  @type('uint8')
  @size(1)
  version;

  @type('uint8')
  @size(1)
  flags;

  @type('uint16')
  @size(1)
  batchId;

  @type('uint32')
  @size(1)
  timestamp;

  // ML Context Data (e.g., raw embedding vector)
  @type('float32')
  @size(512)
  embedding;

  // Raw Audio PCM Data (e.g., 1024 samples)
  @type('float32')
  @size(1024)
  pcmData;
}

// In standard usage:
// const packet = AudioMLBatch.fromBuffer(massiveNetworkBuffer);
// processEmbedding(packet.embedding);
//
// Because `packet.embedding` uses .slice(), it copies the 512 floats into a new ArrayBuffer.
// Once `massiveNetworkBuffer` falls out of scope, V8 can garbage collect it completely,
// saving hundreds of megabytes in a high-throughput streaming application!
