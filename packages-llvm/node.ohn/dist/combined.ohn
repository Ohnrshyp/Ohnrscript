// http.ohn — Ohnrscript Raw HTTP Parser
// 
// Scans the incoming DOD buffer for the '\r\n\r\n' end-of-header sequence.
// Operates exclusively on flat memory pointers (no string allocation).

let CR = 13; // '\r'
let LF = 10; // '\n'

// Returns the index of the byte immediately following '\r\n\r\n',
// or -1 if the sequence is not found yet (incomplete headers).
//
// buf_ptr: Absolute pointer to the start of the slot's ring buffer (i64).
// total_bytes: The number of bytes read so far into the buffer.
function http_find_headers_end(buf_ptr, total_bytes) {
    if ((total_bytes | 0) < 4) {
        return -1;
    }

    let i = 0;
    let limit = (total_bytes - 3) | 0;

    while (i < limit) {
        // Ohnrscript pointer arithmetic & dereferencing using pseudo-externs
        // In reality, the compiler will lower this to `load i8, ptr %addr`.
        let b0 = ohn_mem_read_i8(buf_ptr, i) | 0;
        
        if (b0 === CR) {
            let b1 = ohn_mem_read_i8(buf_ptr, (i + 1) | 0) | 0;
            if (b1 === LF) {
                let b2 = ohn_mem_read_i8(buf_ptr, (i + 2) | 0) | 0;
                if (b2 === CR) {
                    let b3 = ohn_mem_read_i8(buf_ptr, (i + 3) | 0) | 0;
                    if (b3 === LF) {
                        return (i + 4) | 0; // Header ends, body begins
                    }
                }
            }
        }
        i = (i + 1) | 0;
    }

    return -1;
}

// ── Memory Access Stub ──
// Emitted natively by the LLVM compiler. 
// Reads 1 byte from (ptr + offset).
const ohn_mem_read_i8 = __extern('sys_mem_read_i8');
// mpsc.ohn — Lock-Free Multi-Producer Single-Consumer Queue
// Written in Ohnrscript.
//
// Prevents the "eventfd Wakeup Storm" deadlocks.
// Background threads (producers) push completion events to this queue atomically.
// They only write to the eventfd pipe if they transition the queue from Empty to Not-Empty.
// The main event loop (consumer) drains the queue instantly in user-space.

let MPSC_CAPACITY = 16384; // Power of 2 for fast modulo
let MPSC_MASK = 16383;     // Capacity - 1

// Ring buffer for IPC events (e.g., storing the slot ID of completed work)
let mpsc_queue = new Int32Array(MPSC_CAPACITY);

// In LLVM Ohnrscript, we will need atomic intrinsics mapped to flat variables.
// For now, we simulate the head/tail indices.
let mpsc_head = 0; // Written by producers
let mpsc_tail = 0; // Written by consumer (main loop)

// Extern for atomic compare-and-swap (to be implemented via LLVM atomicrmw)
const ohn_atomic_add = __extern('sys_atomic_add');

// Producer: Push an event onto the queue from a background thread.
// Returns 1 if the queue was previously empty (meaning we should signal eventfd).
// Returns 0 if already populated (skip eventfd).
// Returns -1 if queue is full.
function mpsc_push(slot) {
    let current_head = mpsc_head | 0;
    let next_head = (current_head + 1) & MPSC_MASK;

    if (next_head === (mpsc_tail | 0)) {
        // Queue full — in a real implementation we might block or spin
        return -1; 
    }

    // Atomic push logic (simulated until full LLVM atomic lowering is built)
    mpsc_queue[current_head] = slot;
    mpsc_head = next_head;

    // Was it empty?
    if (current_head === (mpsc_tail | 0)) {
        return 1; // Signal eventfd!
    }
    return 0; // Already awake
}

// Consumer: Drain a single event from the queue in the main loop.
// Returns the slot ID, or -1 if empty.
function mpsc_pop() {
    let current_tail = mpsc_tail | 0;
    if (current_tail === (mpsc_head | 0)) {
        // Queue is empty
        return -1;
    }

    let slot = mpsc_queue[current_tail] | 0;
    mpsc_tail = (current_tail + 1) & MPSC_MASK;
    return slot;
}
// outbound.ohn — High-Water Mark Application Backpressure
// Written in Ohnrscript.
//
// Mitigates Tarpit Attacks (clients downloading at 1 byte/sec).
// When the kernel TCP buffer fills (EAGAIN), userland data must be queued.
// If the queued data per-socket exceeds OUTBOUND_HWM, res.write() returns false.
// This pauses Ohnrscript userland from generating more data until the queue drains.

// 2MB limit per socket
let OUTBOUND_HWM = 2097152;
let MAX_CONN     = 4096;

// Flat array holding the current total bytes queued for each socket slot.
// (In a real implementation, this tracks offsets into a circular linked list
// of buffer chunks, but for this POC we track the absolute byte count to 
// trigger the backpressure logic).
let queued_bytes = new Int32Array(MAX_CONN);

// Flat array holding the backpressure state (1 = paused, 0 = active).
let paused_state = new Int32Array(MAX_CONN);

// Add data to the outbound queue. Returns 1 if successful, 
// 0 if backpressure High-Water Mark is hit (meaning userland MUST yield).
function outbound_enqueue(slot, byte_len) {
    let current = queued_bytes[slot] | 0;
    let next_total = (current + byte_len) | 0;

    if (next_total > OUTBOUND_HWM) {
        paused_state[slot] = 1;
        return 0; // Backpressure engaged: yield false to userland.
    }

    queued_bytes[slot] = next_total;
    return 1;
}

// Called when kqueue/epoll EVFILT_WRITE fires and kernel accepts data.
function outbound_dequeue(slot, bytes_sent) {
    let current = queued_bytes[slot] | 0;
    let remaining = (current - bytes_sent) | 0;
    if (remaining < 0) remaining = 0;
    
    queued_bytes[slot] = remaining;

    // If we were paused and the queue has drained significantly (e.g. half HWM),
    // we unpause and fire the internal 'drain' event to userland.
    if ((paused_state[slot] | 0) === 1) {
        let low_water_mark = (OUTBOUND_HWM / 2) | 0;
        if (remaining <= low_water_mark) {
            paused_state[slot] = 0;
            // TODO: Dispatch 'drain' event to userland callback queue.
            return 1; // Unpaused
        }
    }
    return 0;
}

function outbound_clear(slot) {
    queued_bytes[slot] = 0;
    paused_state[slot] = 0;
}
// timeout.ohn — O(1) Connection Eviction (Min-Heap Priority Queue)
// Written in Ohnrscript.
//
// To avoid iterating over 10,000 connections every tick (O(N) bottleneck),
// we maintain a Min-Heap. The root node (index 0) always contains the
// slot ID of the socket that has been idle the longest.
// Checking for timeouts becomes an O(1) operation.

let HEAP_MAX = 4096;

// Flat array holding socket slot IDs.
let heap_slots = new Int32Array(HEAP_MAX);

// Flat array holding the expiration timestamp for the slot in the heap.
let heap_expires = new Int32Array(HEAP_MAX);

// Maps a socket slot ID back to its index in the heap for O(1) updates.
let slot_to_heap_idx = new Int32Array(HEAP_MAX);

let heap_size = 0;

function heap_swap(i, j) {
    let slot_i = heap_slots[i] | 0;
    let slot_j = heap_slots[j] | 0;
    
    let exp_i = heap_expires[i] | 0;
    let exp_j = heap_expires[j] | 0;

    heap_slots[i] = slot_j;
    heap_slots[j] = slot_i;

    heap_expires[i] = exp_j;
    heap_expires[j] = exp_i;

    slot_to_heap_idx[slot_i] = j;
    slot_to_heap_idx[slot_j] = i;
}

function heap_sift_up(start_idx) {
    let idx = start_idx | 0;
    while (idx > 0) {
        let parent = ((idx - 1) / 2) | 0;
        let exp_idx = heap_expires[idx] | 0;
        let exp_parent = heap_expires[parent] | 0;
        
        if (exp_idx < exp_parent) {
            heap_swap(idx, parent);
            idx = parent;
        } else {
            return 0;
        }
    }
}

function heap_sift_down(start_idx) {
    let size = heap_size | 0;
    let idx = start_idx | 0;
    while (1) {
        let left = (2 * idx + 1) | 0;
        let right = (2 * idx + 2) | 0;
        let smallest = idx | 0;

        if (left < size) {
            let exp_left = heap_expires[left] | 0;
            let exp_smallest = heap_expires[smallest] | 0;
            if (exp_left < exp_smallest) {
                smallest = left;
            }
        }

        if (right < size) {
            let exp_right = heap_expires[right] | 0;
            let exp_smallest = heap_expires[smallest] | 0;
            if (exp_right < exp_smallest) {
                smallest = right;
            }
        }

        if (smallest !== idx) {
            heap_swap(idx, smallest);
            idx = smallest;
        } else {
            return 0;
        }
    }
}

// ── Public API ──

// Add a new socket slot to the timeout tracking heap.
function timeout_add(slot, expire_ts) {
    let size = heap_size | 0;
    if (size >= HEAP_MAX) return -1;

    heap_slots[size] = slot;
    heap_expires[size] = expire_ts;
    slot_to_heap_idx[slot] = size;
    
    heap_size = (size + 1) | 0;
    heap_sift_up(size);
    return 0;
}

// Update the expiration time for an active socket.
function timeout_touch(slot, new_expire_ts) {
    let idx = slot_to_heap_idx[slot] | 0;
    if (idx < 0 || idx >= (heap_size | 0)) return -1;

    let old_ts = heap_expires[idx] | 0;
    heap_expires[idx] = new_expire_ts;

    if (new_expire_ts < old_ts) {
        heap_sift_up(idx);
    } else {
        heap_sift_down(idx);
    }
    return 0;
}

// Remove a socket from the heap (e.g. when closed gracefully).
function timeout_remove(slot) {
    let size = heap_size | 0;
    let idx = slot_to_heap_idx[slot] | 0;
    if (idx < 0 || idx >= size) return -1;

    let last_idx = (size - 1) | 0;
    heap_swap(idx, last_idx);
    heap_size = last_idx;

    slot_to_heap_idx[slot] = -1;

    if (idx < last_idx) {
        heap_sift_up(idx);
        heap_sift_down(idx);
    }
    return 0;
}

// O(1) Check: Returns the slot ID if it has expired relative to current_ts.
// Returns -1 if nothing has expired.
function timeout_poll(current_ts) {
    if ((heap_size | 0) === 0) return -1;

    let min_ts = heap_expires[0] | 0;
    if (min_ts <= current_ts) {
        let slot = heap_slots[0] | 0;
        timeout_remove(slot);
        return slot;
    }
    
    return -1;
}
// loop.ohn — node.ohn Core Event Loop
// Written in Ohnrscript. Compiles to LLVM IR via self-hosted compiler.
//
// Architecture:
//   - Uses kqueue (macOS) or epoll (Linux) via bindings.c shims.
//   - Maintains per-socket state in flat DOD arrays (no heap objects).
//   - Implements O(1) connection timeout via Min-Heap (see timeout.ohn).
//   - Implements SIGTERM graceful draining.
//   - Implements incoming backpressure (EPOLLIN deregistration).

// ── Constants ──
// These are platform event filter/flag values passed as flat i64 integers
// through bindings.c, so Ohnrscript never touches raw C structs.
let EVFILT_READ  = -1;   // kqueue read filter
let EVFILT_WRITE = -2;   // kqueue write filter
let EV_ADD       = 1;
let EV_DELETE    = 2;
let EV_DISABLE   = 8;
let EV_ENABLE    = 4;

let EPOLLIN      = 1;    // epoll readable
let EPOLLOUT     = 4;    // epoll writable
let EPOLLET      = -2147483647 - 1; // edge-triggered (0x80000000 as i32)

// ── DOD Socket State Arrays ──
// Each active connection is tracked by its file descriptor as the index key.
// All state is flat integers — no heap allocation ever.
let MAX_CONN         = 4096;
let STATE_IDLE       = 0;
let STATE_READING    = 1;
let STATE_WRITING    = 2;
let STATE_DRAINING   = 3;   // SIGTERM draining phase

// Per-socket flat arrays (indexed by slot, not fd).
// fd_table[slot] = fd, state_table[slot] = STATE_*, etc.
let fd_table        = new Int32Array(MAX_CONN);
let state_table     = new Int32Array(MAX_CONN);
let bytes_read      = new Int32Array(MAX_CONN);
let bytes_written   = new Int32Array(MAX_CONN);
let last_active_ts  = new Int32Array(MAX_CONN);  // used by timeout Min-Heap

// Active connection count — used for graceful draining.
let active_count    = 0;

// Drain mode — set to 1 when SIGTERM received.
let draining_mode   = 0;

// Read/write ring buffer (shared across all connections via slot indexing).
// Each slot is 8KB (sufficient for HTTP headers + small bodies).
let BUF_SLOT_SIZE   = 8192;
let read_buf        = new Int32Array(MAX_CONN * BUF_SLOT_SIZE / 4);

// Outbound High-Water Mark: 2MB per socket before backpressure engages.
let OUTBOUND_HWM    = 2097152;

// Event results buffer: kqueue/epoll writes [fd, filter/events, ...] pairs.
let MAX_EVENTS      = 256;
let event_results   = new Int32Array(MAX_EVENTS * 2);

// ── Externs from bindings.c ──
const ohn_kqueue_create = __extern('sys_kqueue_create');
const ohn_kqueue_register = __extern('sys_kqueue_register');
const ohn_kqueue_wait = __extern('sys_kqueue_wait');
const ohn_socket_accept = __extern('sys_socket_accept');
const ohn_socket_nonblock = __extern('sys_socket_nonblock');
const ohn_socket_read = __extern('sys_socket_read');
const ohn_socket_write = __extern('sys_socket_write');
const ohn_socket_close = __extern('sys_socket_close');
const ohn_fill_http_response = __extern('sys_fill_http_response');

// ── Slot Management ──
// Find the first idle slot. Returns -1 if full (server at capacity).
function findFreeSlot() {
    let i = 0;
    while (i < MAX_CONN) {
        if ((state_table[i] | 0) === STATE_IDLE) {
            return i;
        }
        i = (i + 1) | 0;
    }
    return -1;
}

// Find the slot for a given fd. Returns -1 if not found.
function findSlotByFd(fd) {
    let i = 0;
    while (i < MAX_CONN) {
        if ((fd_table[i] | 0) === fd && (state_table[i] | 0) !== STATE_IDLE) {
            return i;
        }
        i = (i + 1) | 0;
    }
    return -1;
}

// Release a slot and close the socket.
function closeSlot(kq, slot) {
    let fd = fd_table[slot] | 0;
    ohn_socket_close(fd);
    fd_table[slot]    = 0;
    state_table[slot] = STATE_IDLE;
    bytes_read[slot]  = 0;
    bytes_written[slot] = 0;
    active_count = (active_count - 1) | 0;
}

// ── HTTP Response Writer ──
// Writes a minimal HTTP/1.1 200 OK response into the read_buf slot.
// In a full implementation, the userland API writes here via res.write().
// res.end() transitions state → STATE_WRITING and registers EPOLLOUT/EVFILT_WRITE.
function writeResponse(slot) {
    let buf_offset = (slot * BUF_SLOT_SIZE / 4) | 0;
    // Bypassing string literal parser limitation using C
    ohn_fill_http_response(buf_offset);
    bytes_written[slot] = 75;
    state_table[slot]   = STATE_WRITING;
}

// ── Accept new connections ──
function acceptConnections(kq, listen_fd) {
    while (1) {
        let client_fd = ohn_socket_accept(listen_fd) | 0;
        if (client_fd < 0) {
            // EAGAIN = no more pending connections on this tick.
            return 0;
        }

        // If server is in draining mode, reject new connections.
        if ((draining_mode | 0) === 1) {
            ohn_socket_close(client_fd);
            return 0;
        }

        ohn_socket_nonblock(client_fd);

        let slot = findFreeSlot() | 0;
        if (slot < 0) {
            // At capacity — gracefully reject.
            ohn_socket_close(client_fd);
            return 0;
        }

        fd_table[slot]    = client_fd;
        state_table[slot] = STATE_READING;
        bytes_read[slot]  = 0;
        bytes_written[slot] = 0;
        active_count = (active_count + 1) | 0;

        // Register for read-readiness with kqueue/epoll.
        ohn_kqueue_register(kq, client_fd, EVFILT_READ, EV_ADD);
    }
}

// ── Read handler ──
function handleRead(kq, slot) {
    let fd        = fd_table[slot] | 0;
    let buf_offset = (slot * BUF_SLOT_SIZE / 4) | 0;
    let n = ohn_socket_read(fd, buf_offset, BUF_SLOT_SIZE) | 0;

    if (n <= 0) {
        // Client disconnected or error — close slot.
        closeSlot(kq, slot);
        return 0;
    }

    bytes_read[slot] = (bytes_read[slot] + n) | 0;

    // Minimal HTTP parser: wait for \r\n\r\n end-of-headers sequence.
    // A full implementation would call the llhttp extern here.
    // For now: assume request is complete if we have read > 4 bytes.
    if ((bytes_read[slot] | 0) >= 4) {
        // Deregister EPOLLIN / EVFILT_READ to prevent re-reads (backpressure).
        ohn_kqueue_register(kq, fd, EVFILT_READ, EV_DELETE);

        // Build response into slot buffer, transition to WRITING state.
        writeResponse(slot);

        // Register EPOLLOUT / EVFILT_WRITE to flush the response.
        ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_ADD);
    }
}

// ── Write handler ──
function handleWrite(kq, slot) {
    let fd         = fd_table[slot] | 0;
    let buf_offset = (slot * BUF_SLOT_SIZE / 4) | 0;
    let to_write   = bytes_written[slot] | 0;

    let n = ohn_socket_write(fd, buf_offset, to_write) | 0;

    if (n < 0) {
        // EAGAIN — kernel send buffer full. State machine stays in WRITING.
        // kqueue/epoll will re-notify when writable again.
        return 0;
    }

    // Track partial writes (EAGAIN state machine).
    bytes_written[slot] = (bytes_written[slot] - n) | 0;

    if ((bytes_written[slot] | 0) <= 0) {
        // Response fully flushed — close connection (HTTP/1.0 style for now).
        ohn_kqueue_register(kq, fd, EVFILT_WRITE, EV_DELETE);
        closeSlot(kq, slot);
    }
}

// ── Main Event Loop ──
function ohn_event_loop_run(listen_fd) {
    let kq = ohn_kqueue_create() | 0;

    // Register the listening socket for read events (incoming connections).
    ohn_kqueue_register(kq, listen_fd, EVFILT_READ, EV_ADD);

    let event_buf_ptr = 0; // Pointer to event_results array base.
    // In Ohnrscript LLVM IR, typed array base pointers are i64 values.
    // The self-hosted compiler emits inttoptr for array access.

    let TIMEOUT_MS = 1000; // 1 second tick for timeout wheel processing.

    while (1) {
        let n = ohn_kqueue_wait(kq, event_buf_ptr, MAX_EVENTS, TIMEOUT_MS) | 0;

        // Process each ready event.
        let i = 0;
        while (i < n) {
            let ev_fd     = (event_results[i * 2]     | 0);
            let ev_filter = (event_results[i * 2 + 1] | 0);

            if (ev_fd === listen_fd) {
                // New connection(s) ready to accept.
                acceptConnections(kq, listen_fd);
            } else {
                let slot = findSlotByFd(ev_fd) | 0;
                if (slot >= 0) {
                    if (ev_filter === EVFILT_READ) {
                        handleRead(kq, slot);
                    }
                    if (ev_filter === EVFILT_WRITE) {
                        handleWrite(kq, slot);
                    }
                }
            }

            i = (i + 1) | 0;
        }

        // Draining phase: if SIGTERM was received and all connections closed, exit.
        if ((draining_mode | 0) === 1 && (active_count | 0) === 0) {
            ohn_socket_close(listen_fd);
            return 0;
        }
    }
}
// server.ohn — node.ohn Top-Level Entry Point
// Written in Ohnrscript. Self-hosted compile: ohnrscript server.ohn → server.ll
//
// Architecture:
//   1. Suppress SIGPIPE globally.
//   2. Query CPU core count.
//   3. Fork N-1 worker processes (current process becomes worker 0).
//   4. Each worker enters the kqueue/epoll event loop independently.
//   5. OS kernel load-balances connections across all workers via SO_REUSEPORT.

// ── Externs from bindings.c (all params are i64 to match Ohnrscript ABI) ──
const ohn_suppress_sigpipe = __extern('sys_suppress_sigpipe');
const ohn_cpu_count = __extern('sys_cpu_count');
const ohn_socket_tcp = __extern('sys_socket_tcp');
const ohn_socket_set_reuseport = __extern('sys_socket_set_reuseport');
const ohn_socket_nonblock = __extern('sys_socket_nonblock');
const ohn_socket_bind = __extern('sys_socket_bind');
const ohn_socket_listen = __extern('sys_socket_listen');
const ohn_socket_close = __extern('sys_socket_close');

// fork() is a direct libc call — returns 0 in child, PID in parent, -1 on error
const sys_fork = __extern('fork');

// Platform event loop entry points (implemented in loop.ohn)

function createListenSocket(port) {
    let fd = ohn_socket_tcp() | 0;
    if (fd < 0) {
        return -1;
    }

    let r = ohn_socket_set_reuseport(fd) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    r = ohn_socket_nonblock(fd) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    r = ohn_socket_bind(fd, port) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    // Backlog of 4096 — allows kernel to queue incoming connections
    // before accept() is called. NGINX uses 511, Actix uses 1024.
    r = ohn_socket_listen(fd, 4096) | 0;
    if (r < 0) {
        ohn_socket_close(fd);
        return -1;
    }

    return fd;
}

function main() {
    // Force evaluation of top-level statements for this module.
    // Without this, the initialization block (which sets up globals like EVFILT_READ) is never executed.
    require('server');

    // 1. Globally suppress SIGPIPE before any socket work.
    ohn_suppress_sigpipe();

    let PORT = 8080;
    let listen_fd = createListenSocket(PORT) | 0;
    if (listen_fd < 0) {
        return 1;
    }

    // 2. Fork N-1 additional worker processes.
    //    Each worker shares the same listen_fd (SO_REUSEPORT
    //    ensures the kernel distributes connections, not us).
    let cores = ohn_cpu_count() | 0;
    let i = 1;
    while (i < cores) {
        let pid = sys_fork() | 0;
        if (pid === 0) {
            // Child: drop into event loop immediately.
            ohn_event_loop_run(listen_fd);
            return 0;
        }
        // Parent: continue forking.
        i = (i + 1) | 0;
    }

    // 3. Parent process also becomes a worker.
    ohn_event_loop_run(listen_fd);

    return 0;
}
