// timeout.ohn — O(1) Connection Eviction (Min-Heap Priority Queue)
// Written in Ohnrscript.
//
// To avoid iterating over 10,000 connections every tick (O(N) bottleneck),
// we maintain a Min-Heap. The root node (index 0) always contains the
// slot ID of the socket that has been idle the longest.
// Checking for timeouts becomes an O(1) operation.

let HEAP_MAX = 4096;

// Flat array holding socket slot IDs.
let heap_slots = new Int32Array(HEAP_MAX);

// Flat array holding the expiration timestamp for the slot in the heap.
let heap_expires = new Int32Array(HEAP_MAX);

// Maps a socket slot ID back to its index in the heap for O(1) updates.
let slot_to_heap_idx = new Int32Array(HEAP_MAX);

let heap_size = 0;

function heap_swap(i, j) {
    let slot_i = heap_slots[i] | 0;
    let slot_j = heap_slots[j] | 0;
    
    let exp_i = heap_expires[i] | 0;
    let exp_j = heap_expires[j] | 0;

    heap_slots[i] = slot_j;
    heap_slots[j] = slot_i;

    heap_expires[i] = exp_j;
    heap_expires[j] = exp_i;

    slot_to_heap_idx[slot_i] = j;
    slot_to_heap_idx[slot_j] = i;
}

function heap_sift_up(idx) {
    while (idx > 0) {
        let parent = ((idx - 1) / 2) | 0;
        let exp_idx = heap_expires[idx] | 0;
        let exp_parent = heap_expires[parent] | 0;
        
        if (exp_idx < exp_parent) {
            heap_swap(idx, parent);
            idx = parent;
        } else {
            return;
        }
    }
}

function heap_sift_down(idx) {
    let size = heap_size | 0;
    while (1) {
        let left = (2 * idx + 1) | 0;
        let right = (2 * idx + 2) | 0;
        let smallest = idx | 0;

        if (left < size) {
            let exp_left = heap_expires[left] | 0;
            let exp_smallest = heap_expires[smallest] | 0;
            if (exp_left < exp_smallest) {
                smallest = left;
            }
        }

        if (right < size) {
            let exp_right = heap_expires[right] | 0;
            let exp_smallest = heap_expires[smallest] | 0;
            if (exp_right < exp_smallest) {
                smallest = right;
            }
        }

        if (smallest != idx) {
            heap_swap(idx, smallest);
            idx = smallest;
        } else {
            return;
        }
    }
}

// ── Public API ──

// Add a new socket slot to the timeout tracking heap.
function timeout_add(slot, expire_ts) {
    let size = heap_size | 0;
    if (size >= HEAP_MAX) return -1;

    heap_slots[size] = slot;
    heap_expires[size] = expire_ts;
    slot_to_heap_idx[slot] = size;
    
    heap_size = (size + 1) | 0;
    heap_sift_up(size);
    return 0;
}

// Update the expiration time for an active socket.
function timeout_touch(slot, new_expire_ts) {
    let idx = slot_to_heap_idx[slot] | 0;
    if (idx < 0 || idx >= (heap_size | 0)) return -1;

    let old_ts = heap_expires[idx] | 0;
    heap_expires[idx] = new_expire_ts;

    if (new_expire_ts < old_ts) {
        heap_sift_up(idx);
    } else {
        heap_sift_down(idx);
    }
    return 0;
}

// Remove a socket from the heap (e.g. when closed gracefully).
function timeout_remove(slot) {
    let size = heap_size | 0;
    let idx = slot_to_heap_idx[slot] | 0;
    if (idx < 0 || idx >= size) return -1;

    let last_idx = (size - 1) | 0;
    heap_swap(idx, last_idx);
    heap_size = last_idx;

    slot_to_heap_idx[slot] = -1;

    if (idx < last_idx) {
        heap_sift_up(idx);
        heap_sift_down(idx);
    }
    return 0;
}

// O(1) Check: Returns the slot ID if it has expired relative to current_ts.
// Returns -1 if nothing has expired.
function timeout_poll(current_ts) {
    if ((heap_size | 0) == 0) return -1;

    let min_ts = heap_expires[0] | 0;
    if (min_ts <= current_ts) {
        let slot = heap_slots[0] | 0;
        timeout_remove(slot);
        return slot;
    }
    
    return -1;
}
