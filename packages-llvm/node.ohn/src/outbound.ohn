// outbound.ohn — High-Water Mark Application Backpressure
// Written in Ohnrscript.
//
// Mitigates Tarpit Attacks (clients downloading at 1 byte/sec).
// When the kernel TCP buffer fills (EAGAIN), userland data must be queued.
// If the queued data per-socket exceeds OUTBOUND_HWM, res.write() returns false.
// This pauses Ohnrscript userland from generating more data until the queue drains.

// 2MB limit per socket
let OUTBOUND_HWM = 2097152;
let MAX_CONN     = 4096;

// Flat array holding the current total bytes queued for each socket slot.
// (In a real implementation, this tracks offsets into a circular linked list
// of buffer chunks, but for this POC we track the absolute byte count to 
// trigger the backpressure logic).
let queued_bytes = new Int32Array(MAX_CONN);

// Flat array holding the backpressure state (1 = paused, 0 = active).
let paused_state = new Int32Array(MAX_CONN);

// Add data to the outbound queue. Returns 1 if successful, 
// 0 if backpressure High-Water Mark is hit (meaning userland MUST yield).
function outbound_enqueue(slot, byte_len) {
    let current = queued_bytes[slot] | 0;
    let next_total = (current + byte_len) | 0;

    if (next_total > OUTBOUND_HWM) {
        paused_state[slot] = 1;
        return 0; // Backpressure engaged: yield false to userland.
    }

    queued_bytes[slot] = next_total;
    return 1;
}

// Called when the event loop POLL_WRITE fires and kernel accepts data.
function outbound_dequeue(slot, bytes_sent) {
    let current = queued_bytes[slot] | 0;
    let remaining = (current - bytes_sent) | 0;
    if (remaining < 0) remaining = 0;
    
    queued_bytes[slot] = remaining;

    // If we were paused and the queue has drained significantly (e.g. half HWM),
    // we unpause and fire the internal 'drain' event to userland.
    if ((paused_state[slot] | 0) === 1) {
        let low_water_mark = (OUTBOUND_HWM / 2) | 0;
        if (remaining <= low_water_mark) {
            paused_state[slot] = 0;
            // TODO: Dispatch 'drain' event to userland callback queue.
            return 1; // Unpaused
        }
    }
    return 0;
}

function outbound_clear(slot) {
    queued_bytes[slot] = 0;
    paused_state[slot] = 0;
}
