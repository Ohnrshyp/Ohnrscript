// buffer-parsing.ohn
// Ohnrscript Example: Reading and Writing Raw Buffers
//
// Demonstrates:
//   - TypedArray allocation with `new Uint8Array()`
//   - Byte-level read/write via index access
//   - Multi-byte integer reconstruction with bit-shifts
//   - The Data-Oriented Design memory model
//
// Compile: node compiler/scripts/compile.js examples/buffer-parsing.ohn

'use strict';

// ── Reading multi-byte integers from a raw byte buffer ──

// Read a 16-bit unsigned integer (big-endian) from a byte buffer.
function readUint16_BE(buffer, byteOffset) {
    let b0 = buffer[byteOffset] | 0;
    let b1 = buffer[(byteOffset + 1) | 0] | 0;
    return ((b0 << 8) | b1) | 0;
}

// Read a 32-bit unsigned integer (little-endian) from a byte buffer.
function readUint32_LE(buffer, byteOffset) {
    let b0 = buffer[byteOffset] | 0;
    let b1 = buffer[(byteOffset + 1) | 0] | 0;
    let b2 = buffer[(byteOffset + 2) | 0] | 0;
    let b3 = buffer[(byteOffset + 3) | 0] | 0;
    return ((b3 << 24) | (b2 << 16) | (b1 << 8) | b0) >>> 0;
}

// ── Writing multi-byte integers to a raw byte buffer ──

// Write a 16-bit unsigned integer (big-endian) to a byte buffer.
function writeUint16_BE(buffer, byteOffset, value) {
    buffer[byteOffset] = (value >>> 8) & 0xFF;
    buffer[(byteOffset + 1) | 0] = value & 0xFF;
}

// Write a 32-bit unsigned integer (big-endian) to a byte buffer.
function writeUint32_BE(buffer, byteOffset, value) {
    buffer[byteOffset] = (value >>> 24) & 0xFF;
    buffer[(byteOffset + 1) | 0] = (value >>> 16) & 0xFF;
    buffer[(byteOffset + 2) | 0] = (value >>> 8) & 0xFF;
    buffer[(byteOffset + 3) | 0] = value & 0xFF;
}

// ── Example: Parse a simple packet header ──
//
// Header layout (8 bytes):
//   [0]    version   (uint8)
//   [1]    flags     (uint8)
//   [2-3]  length    (uint16 big-endian)
//   [4-7]  checksum  (uint32 big-endian)

function parseHeader(buffer) {
    let version = buffer[0] | 0;
    let flags = buffer[1] | 0;
    let length = readUint16_BE(buffer, 2) | 0;
    // Return the version as a validation check
    return version;
}

module.exports = {
    readUint16_BE,
    readUint32_LE,
    writeUint16_BE,
    writeUint32_BE,
    parseHeader
};
