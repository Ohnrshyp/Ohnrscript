// fixed-point-math.ohn
// Ohnrscript Example: 26+6 Bit-Packed Fixed-Point Arithmetic
//
// Demonstrates:
//   - Ohnrscript's alternative to floating-point numbers
//   - pack() and multiply() — the core fixed-point operations
//   - 100% deterministic math across ARM and x86 architectures
//
// The 26+6 encoding stores:
//   - 26 bits for the integer part (range: ±33 million)
//   - 6 bits for the fractional part (precision: 1/64 ≈ 0.015625)
//
// Compile (LLVM):  node compiler/scripts/compile.js --target llvm examples/fixed-point-math.ohn

'use strict';

// Scale factor: 2^6 = 64
const FP_SCALE = 64;

// ── Core Operations ──

// Pack an integer into 26+6 fixed-point representation.
// Example: pack(3) → 192 (which is 3 * 64)
function pack(value) {
    return (value * FP_SCALE) | 0;
}

// Multiply two 26+6 fixed-point values.
// Shift right by 6 after multiplication to remove the doubled scale.
function multiply(a, b) {
    return ((a * b) >> 6) | 0;
}

// Add two fixed-point values (no shift needed — scale is preserved).
function add(a, b) {
    return (a + b) | 0;
}

// Subtract two fixed-point values.
function subtract(a, b) {
    return (a - b) | 0;
}

// ── Example: Fixed-Point Dot Product ──
// Compute the dot product of two vectors stored as fixed-point values.

function dotProduct(vecA, vecB, length) {
    let sum = 0;
    let i = 0;
    while (i < length) {
        let a = vecA[i] | 0;
        let b = vecB[i] | 0;
        sum = (sum + multiply(a, b)) | 0;
        i = (i + 1) | 0;
    }
    return sum;
}

// ── Example: Linear Interpolation (lerp) ──
// lerp(a, b, t) = a + t * (b - a)
// where t is a fixed-point value between 0 and pack(1)

function lerp(a, b, t) {
    let diff = subtract(b, a) | 0;
    let scaled = multiply(diff, t) | 0;
    return add(a, scaled) | 0;
}

module.exports = {
    pack,
    multiply,
    add,
    subtract,
    dotProduct,
    lerp
};
