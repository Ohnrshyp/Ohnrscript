{
  "name": "ohnrscript-language-support",
  "displayName": "Ohnrscript",
  "description": "Official syntax highlighting, IntelliSense, and language server support for the Ohnrscript programming language.",
  "version": "0.2.1",
  "publisher": "ohnrshyp",
  "icon": "ohn-icon.png",
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohnrshyp/ohnrscript"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:ohnrscript"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ohnrscript",
        "aliases": [
          "Ohnrscript",
          "ohn"
        ],
        "extensions": [
          ".ohn"
        ],
        "icon": {
          "light": "./ohn-icon.svg",
          "dark": "./ohn-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ohnrscript",
        "scopeName": "source.ohn",
        "path": "./syntaxes/ohnrscript.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
