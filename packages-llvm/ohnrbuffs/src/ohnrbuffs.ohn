// ohnrbuffs.ohn
// Core memory writing functions for Ohnrbuffs

// Writes a 32-bit integer to the word-aligned offset in the buffer.
function ohnr_writeI32(buffer, wordOffset, value) {
    buffer[wordOffset] = value | 0;
    return (wordOffset + 1) | 0;
}

// Reads a 32-bit integer from the word-aligned offset in the buffer.
function ohnr_readI32(buffer, wordOffset) {
    return buffer[wordOffset] | 0;
}

// Writes a string to the buffer.
// Since this is a bare-metal benchmark, strings are represented as 
// sequential 32-bit words for maximum throughput (4 bytes per word).
// The first word is the string length.
function ohnr_writeString(buffer, wordOffset, strPtr, strLen) {
    let offset = wordOffset | 0;
    buffer[offset] = strLen | 0;
    offset = (offset + 1) | 0;
    
    let i = 0;
    while (i < strLen) {
        buffer[offset] = strPtr[i] | 0;
        offset = (offset + 1) | 0;
        i = (i + 1) | 0;
    }
    
    return offset | 0;
}

function ohnr_readStringLen(buffer, wordOffset) {
    return buffer[wordOffset] | 0;
}

function ohnr_skipString(buffer, wordOffset) {
    let len = buffer[wordOffset] | 0;
    return (wordOffset + 1 + len) | 0;
}
