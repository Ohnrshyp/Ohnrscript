{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ohnrscript",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ohn",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ohn",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ohn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ohn",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ohn",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ohn",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ohn",
          "match": "\\b(true|false|null|undefined)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ohn",
          "match": "\\b(if|else|while|for|return|throw|continue|break)\\b"
        },
        {
          "name": "storage.type.ohn",
          "match": "\\b(const|let|var|function|class)\\b"
        },
        {
          "name": "keyword.operator.new.ohn",
          "match": "\\b(new)\\b"
        },
        {
          "name": "keyword.operator.expression.ohn",
          "match": "\\b(typeof)\\b"
        },
        {
          "name": "variable.language.this.ohn",
          "match": "\\b(this)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ohn",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.ohn",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ohn",
          "match": "(===|!==|<=|>=|<<|>>>|>>|\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\|=|&=|\\^=|\\|\\||&&|<|>|\\+|-|\\*|/|%|\\||&|\\^|!|=)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ohn",
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*(?=\\()"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "support.class.ohn",
          "match": "\\b([A-Z][a-zA-Z0-9_$]*)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.ohn",
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\b"
        }
      ]
    }
  },
  "scopeName": "source.ohn"
}
