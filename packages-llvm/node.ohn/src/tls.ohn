// tls.ohn — TLS Client/Server API wrapper
// Provides the 'tls' module for Ohnrscript developers

const sys_tls_connect = __extern('sys_tls_connect');
const sys_tls_inject_ca = __extern('sys_tls_inject_ca');
const mpsc_pop = __extern('mpsc_pop');

export const tls = {
    /**
     * Upgrades an existing socket connection to TLS (Client-side)
     * 
     * @param {number} socket_fd - The underlying OS file descriptor
     * @param {object} options - TLS configuration options
     * @param {string} options.servername - The hostname to verify against the certificate (SNI)
     * @param {string} [options.ca] - Optional raw PEM string for a localized microservice Certificate Authority
     * @returns {Promise<number>} - The secured socket fd
     */
    connect: async function(socket_fd, options) {
        // Resolve internal connection tracking slot
        // For demonstration, assume fd maps directly to slot or is resolved via native hook.
        let slot = socket_fd; // Simplified for now

        let servername_ptr = 0;
        // if options.servername exists, map to ptr in real implementation

        // Pass is_server = 0 for client outbound connections
        sys_tls_connect(slot, socket_fd, servername_ptr, 0);

        // Explicit Hybrid CA support for localized connections without polluting global ENV state
        if (options && options.ca) {
            let ca_str_ptr = __string_to_ptr(options.ca);
            let ca_len = options.ca.length;
            // Parses the cert into this specific slot's mbedtls_ssl_config context
            sys_tls_inject_ca(slot, ca_str_ptr, ca_len);
        }

        // The event loop will asynchronously drive sys_tls_handshake()
        // We await handshake completion by polling the lock-free MPSC queue
        return new Promise((resolve, reject) => {
            const timer = setInterval(() => {
                let completed_slot = mpsc_pop();
                if (completed_slot === slot) {
                    clearInterval(timer);
                    resolve(socket_fd);
                } else if (completed_slot !== -1) {
                    // It's a completion for a different slot. 
                    // In a real implementation we'd route this via an EventEmitter, 
                    // but for this POC we'll re-queue or drop it.
                    // For now we'll just ignore other slots to keep the example simple.
                }
            }, 10);
        });
    }
};
